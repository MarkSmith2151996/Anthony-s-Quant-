# Systemd service for BerjQuant
# Install: sudo cp deploy/berjquant.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now berjquant
#
# Logs:    journalctl -u berjquant -f

[Unit]
Description=BerjQuant Trading Engine
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/berjquant
Environment=PATH=/home/%i/berjquant/.venv/bin:/usr/bin:/bin
ExecStart=/home/%i/berjquant/.venv/bin/python run_pipeline.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
